# ════════════════════════════════════════════════════════════════
# EmprendeTech — Variables de entorno
# Copia este archivo a .env.local (local) o agrégalas en Vercel (producción).
# ════════════════════════════════════════════════════════════════

# ─── Supabase — OBLIGATORIAS (sin estas, la app da error 500) ───
# Las consigues en: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_o_publishable_key
# service_role (SECRETO — solo backend; se usa en el webhook de Mercado Pago)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ─── App — OBLIGATORIAS ─────────────────────────────────────────
# En producción pon la URL real de Vercel (ej: https://emprendetech.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EmprendeTech

# ─── Login con Google/Facebook — OPCIONAL ──────────────────────
# Déjalo en "false" (o no lo pongas) hasta que actives los proveedores en
# Supabase → Authentication → Providers. Mientras esté apagado, los botones
# muestran un aviso amigable y NO dan el error "Unsupported provider".
# Cuando ya los actives en Supabase, ponlo en "true".
NEXT_PUBLIC_ENABLE_OAUTH=false

# ─── Mercado Pago — OPCIONALES (la app funciona sin estas) ──────
# mercadopago.com.mx/developers → credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Para OAuth de conexión de cuenta de vendedor (Vender Online / cobros tienda)
# Crear app en https://www.mercadopago.com.mx/developers/panel/app (Marketplace type)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# ─── Stripe Connect (OAuth) — OPCIONALES (pagos con Stripe) ─────
# Secret key de la PLATAFORMA: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
# client_id de Connect (empieza con ca_): dashboard.stripe.com → Connect → Settings → OAuth
# Registra el redirect URI: https://TU_APP/api/oauth/stripe/callback
STRIPE_CONNECT_CLIENT_ID=
# Webhook para registrar ventas al pagarse: Developers → Webhooks → endpoint
# https://TU_APP/api/stripe/webhook (evento checkout.session.completed). Copia el
# "Signing secret" (whsec_...) aquí:
STRIPE_WEBHOOK_SECRET=
