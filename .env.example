# ════════════════════════════════════════════════════════════════
# EmprendeTech — Variables de entorno
# Copia este archivo a .env.local (local) o agrégalas en Vercel (producción).
# ════════════════════════════════════════════════════════════════

# ─── Supabase — OBLIGATORIAS (sin estas, la app da error 500) ───
# Las consigues en: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_o_publishable_key
# service_role (SECRETO — solo backend; se usa en el webhook de Mercado Pago)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ─── App — OBLIGATORIAS ─────────────────────────────────────────
# En producción pon la URL real de Vercel (ej: https://emprendetech.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EmprendeTech

# ─── Mercado Pago — OPCIONALES (la app funciona sin estas) ──────
# mercadopago.com.mx/developers → credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
